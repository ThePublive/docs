    "indexing": "all",
    "metatags": {
      "og:site_name": "Publive Docs",
      "twitter:card": "summary_large_image",
      "twitter:site": "@the_publive"
    }
  },
  "search": {
    "prompt": "Search Publive docs..."
  },
  "metadata": {
    "timestamp": true
  },
