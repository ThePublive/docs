{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Publive Docs",
  "description": "Docs for Publive DXP and AXP: the headless CMS for digital publishers, and the platform that makes brands visible and citable in ChatGPT, AI Overviews, Perplexity, and Gemini.",
