  "redirects": [
    {
      "source": "/changelog",
      "destination": "/dxp/changelog"
    },
    {
      "source": "/changelog/dxp",
      "destination": "/dxp/changelog"
    },
    {
      "source": "/changelog/axp",
      "destination": "/axp/changelog"
    },
    {
      "source": "/documentation",
      "destination": "/dxp/documentation"
    },
    {
      "source": "/documentation/:slug*",
      "destination": "/dxp/documentation/:slug*"
    },
    {
      "source": "/api-reference",
      "destination": "/dxp/api-reference"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/dxp/api-reference/:slug*"
    },
    {
      "source": "/",
      "destination": "/dxp"
    }
